WORK_DIR="${WORK_DIR:-$SCRIPT_DIR/work}"
REPOS_DIR="${REPOS_DIR:-$WORK_DIR/repos}"
CPG_REPO_DIR="${CPG_REPO_DIR:-$WORK_DIR/cpg}"
OUT_DIR="${OUT_DIR:-$SCRIPT_DIR/cpg-output}"
LOG_DIR="${LOG_DIR:-$SCRIPT_DIR/logs}"
STATS_INTERVAL_SECONDS="${STATS_INTERVAL_SECONDS:-1}"
MAX_CPG_SECONDS="${MAX_CPG_SECONDS:-10800}"

CPG_GIT_URL="${CPG_GIT_URL:-https://github.com/Fraunhofer-AISEC/cpg.git}"
CPG_REF="${CPG_REF:-main}"
DOCKER_IMAGE="${DOCKER_IMAGE:-fraunhofer-cpg-runner:local}"

CPG_ANALYSIS_MODE="${CPG_ANALYSIS_MODE:-fast}"
MAX_COMPLEXITY_CF_DFG="${MAX_COMPLEXITY_CF_DFG:-50}"
SKIP_EXISTING="${SKIP_EXISTING:-1}"
CUSTOM_PASS_LIST="${CUSTOM_PASS_LIST:-TypeHierarchyResolver,SymbolResolver,DFGPass,EvaluationOrderGraphPass,TypeResolver,ControlFlowSensitiveDFGPass,ControlDependenceGraphPass,ProgramDependenceGraphPass}"

ENABLE_JAVA_FRONTEND="${ENABLE_JAVA_FRONTEND:-true}"
ENABLE_CXX_FRONTEND="${ENABLE_CXX_FRONTEND:-false}"
ENABLE_GO_FRONTEND="${ENABLE_GO_FRONTEND:-false}"
ENABLE_PYTHON_FRONTEND="${ENABLE_PYTHON_FRONTEND:-true}"
ENABLE_LLVM_FRONTEND="${ENABLE_LLVM_FRONTEND:-false}"
ENABLE_TYPESCRIPT_FRONTEND="${ENABLE_TYPESCRIPT_FRONTEND:-false}"
ENABLE_RUBY_FRONTEND="${ENABLE_RUBY_FRONTEND:-false}"
ENABLE_JVM_FRONTEND="${ENABLE_JVM_FRONTEND:-false}"
ENABLE_INI_FRONTEND="${ENABLE_INI_FRONTEND:-false}"
ENABLE_MCP_MODULE="${ENABLE_MCP_MODULE:-false}"

JEP_LIBRARY_PATH="${JEP_LIBRARY_PATH:-/root/.virtualenvs/cpg/lib/python3.14/site-packages/jep}"
JEP_PYTHON_PATH="${JEP_PYTHON_PATH:-/root/.virtualenvs/cpg/lib/python3.14/site-packages}"
