# Repository root. Scripts set SCRIPT_DIR before sourcing this file; this fallback
# keeps manual `source config/.env` usable from the repository root.
SCRIPT_DIR="${SCRIPT_DIR:-$(pwd)}"

# Base working directory for cloned target repos and Fraunhofer CPG sources.
WORK_DIR="${WORK_DIR:-$SCRIPT_DIR/work}"

# Directory where target GitHub repositories are cloned per project/commit.
REPOS_DIR="${REPOS_DIR:-$WORK_DIR/repos}"

# Directory where upstream Fraunhofer CPG is cloned and built by ./init.sh.
CPG_REPO_DIR="${CPG_REPO_DIR:-$WORK_DIR/cpg}"

# Directory where generated CPG JSON files and dataset run artifacts are written.
OUT_DIR="${OUT_DIR:-$SCRIPT_DIR/cpg-output}"

# Patched Fraunhofer CPG Git repository used by ./init.sh.
CPG_GIT_URL="${CPG_GIT_URL:-ssh://git@gitverse.ru:2222/trndc-skoltech/fraunhofer-cpg.git}"

# Patched Fraunhofer CPG git ref checked out by ./init.sh.
CPG_REF="${CPG_REF:-bench/frontend-robustness}"

# Docker image used to build and run Fraunhofer CPG.
DOCKER_IMAGE="${DOCKER_IMAGE:-fraunhofer-cpg-clean:local}"

# JEP native library path inside the Docker image; required by CPG runtime.
JEP_LIBRARY_PATH="${JEP_LIBRARY_PATH:-/root/.virtualenvs/cpg/lib/python3.14/site-packages/jep}"

# Python site-packages path inside the Docker image; required by CPG runtime.
JEP_PYTHON_PATH="${JEP_PYTHON_PATH:-/root/.virtualenvs/cpg/lib/python3.14/site-packages}"

# Dataset JSONL used when ./build_dataset_best_effort.sh is run without arguments.
DATASET="${DATASET:-$SCRIPT_DIR/datasets/tasks 3.jsonl}"

# Which object from each dataset row to build: vuln, task, or both.
DATASET_TARGET="${DATASET_TARGET:-vuln}"

# Which commit fields to build for each selected object.
DATASET_COMMIT_FIELDS="${DATASET_COMMIT_FIELDS:-vuln_commit,safe_commit}"

# 1-based start offset over unique selected build records; useful for chunked runs.
DATASET_START="${DATASET_START:-1}"

# Maximum number of unique selected build records; 0 means all records.
DATASET_LIMIT="${DATASET_LIMIT:-0}"

# Dataset run id; outputs go to cpg-output/${RUN_ID}.dataset/.
RUN_ID="${RUN_ID:-tasks3_vuln_main}"

# Set to 1 to only parse dataset records and print the manifest without building CPGs.
DRY_RUN="${DRY_RUN:-0}"

# Set to 1 to skip records whose output JSON already exists and is non-empty.
SKIP_EXISTING="${SKIP_EXISTING:-1}"

# Set to 1 to first run CPG per source file and exclude files that fail alone.
PRECHECK_FILES="${PRECHECK_FILES:-1}"

# Source files passed to CPG; current value selects production Java and excludes tests.
SOURCE_GLOB="${SOURCE_GLOB:-./*/src/main/java/*.java}"

# Max combined-CPG fallback retries after precheck; each retry excludes one failing file.
MAX_RETRIES="${MAX_RETRIES:-5}"

# Docker stats sampling interval in seconds for docker_samples.csv.
STATS_INTERVAL_SECONDS="${STATS_INTERVAL_SECONDS:-1}"
